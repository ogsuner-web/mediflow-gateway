# Variables del gateway de MediFlow (en Railway: Service -> Variables)

# --- IA ---
GEMINI_API_KEY=tu_clave_de_google_gemini

# --- Base de datos (volume de Railway) ---
DATABASE_URL=file:/data/gateway.db

# --- Mercado Pago (suscripciones) ---
# Token de la cuenta de MP. Para probar: TEST-xxxx. En producción: APP_USR-xxxx.
MP_ACCESS_TOKEN=
# Cotización USD -> ARS del día (MP Argentina cobra en pesos). OBLIGATORIA para que funcione el pago.
USD_ARS=
# Moneda de cobro (default ARS)
MP_CURRENCY=ARS
# Sitio público, para la vuelta post-pago
WEB_URL=https://mediflow-med.netlify.app

# PORT lo define Railway automáticamente
